# Used when the site is served by Hostinger (LiteSpeed/Apache + Hostinger CDN). Ignored by other hosts.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  # The page, code, data and routes must always be revalidated (browser AND the CDN), so a new deploy shows up at once.
  # Without this the server defaults to "cache for 7 days" and visitors can be served stale code for a week.
  <FilesMatch "\.(html|js|css|json|webmanifest)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
</IfModule>
DirectoryIndex index.html
